# GitLab
GITLAB_URL=https://gitlab.example.com
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
# Optional default project ID
# GITLAB_PROJECT_ID=group%2Fproject

# Alibaba Cloud ARMS/SLS
BUGLENS_ALIBABA_ACCESS_KEY_ID=your_access_key_id
BUGLENS_ALIBABA_ACCESS_KEY_SECRET=your_access_key_secret
BUGLENS_ALIBABA_REGION_ID=cn-hangzhou
# Optional STS token
# BUGLENS_ALIBABA_SECURITY_TOKEN=
# Optional endpoint overrides
# BUGLENS_ARMS_ENDPOINT=arms.aliyuncs.com
# BUGLENS_SLS_ENDPOINT=cn-hangzhou.log.aliyuncs.com
BUGLENS_RUM_SLS_PROJECT=your_rum_project
BUGLENS_RUM_SLS_LOGSTORE=your_rum_logstore

# Optional monitoring tuning
# BUGLENS_MONITORING_MAX_RETRIES=2
# BUGLENS_MONITORING_BASE_BACKOFF_SECONDS=0.25
# BUGLENS_MONITORING_MAX_BACKOFF_SECONDS=5.0
# BUGLENS_MONITORING_MOCK=false

# Optional logging
# BUGLENS_LOG_LEVEL=info
# BUGLENS_MCP_LOG_LEVEL=info

# Optional mcp serve defaults
# BUGLENS_MCP_TRANSPORT=stdio
# BUGLENS_MCP_HOST=127.0.0.1
# BUGLENS_MCP_PORT=8000
# BUGLENS_MCP_STREAMABLE_HTTP_PATH=/mcp
